{
  "$id": "https://jobbot.invalid/schema/data/rules.json",
  "title": "Rules",
  "description": "The rules that decide which jobs are shown, in the order they're applied: the first that hides a job names it. Each rule's choices bring their own words; a person adds their own words beside them. `role_sources` names where the jobs of some roles are posted: choosing one of its roles (in one of its countries, if it names any) adds that source to the person's Sources, which they can remove. `titles` are the job titles offered under each role: a person who picks some has that role mean only those titles. `fields` sorts the roles into tech and business. `github_lists` is what the GitHub internship lists the engine compares against carry: someone looking for none of it isn't shown the comparison. Read by the engine (jobbot_engine/rules/judge.py) and the app (src/shared/rules.ts).",
  "rules": [
    {
      "id": "kind",
      "name": "Job types",
      "formerly": ["Kind of job"],
      "about": "Only jobs whose title says they're one of these are collected."
    },
    {
      "id": "companies",
      "name": "Hidden companies",
      "formerly": ["Companies you hide"],
      "about": "Jobs at these companies are hidden."
    },
    {
      "id": "ruled_out",
      "name": "Excluded words",
      "formerly": ["Words you rule out"],
      "about": "Jobs with these words in the title are hidden."
    },
    {
      "id": "roles",
      "name": "Roles",
      "about": "Only jobs whose title names one of these roles are shown."
    },
    {
      "id": "places",
      "name": "Locations",
      "formerly": ["Places"],
      "about": "Jobs only in other countries are hidden. A place jobbot doesn't recognise is shown."
    },
    {
      "id": "terms",
      "name": "Terms",
      "about": "Jobs only for other terms are hidden. A job that names no term is shown."
    },
    {
      "id": "sponsorship",
      "name": "Visa sponsorship",
      "formerly": ["Won't sponsor"],
      "about": "Jobs outside your home country that say they won't sponsor a visa are hidden, when your profile says you need one."
    },
    {
      "id": "age",
      "name": "Old postings",
      "formerly": ["Found late"],
      "about": "Jobs that were already this old when jobbot found them are hidden, except at companies you follow."
    },
    {
      "id": "repeats",
      "name": "Duplicates",
      "formerly": ["Repeats"],
      "about": "A job that's already shown is shown once. Another copy, from the same board or from a GitHub list, is hidden."
    }
