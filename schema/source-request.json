{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobbot.invalid/schema/source-request.json",
  "title": "SourceRequest",
  "description": "A link a person wanted checked that jobbot can't read yet, kept for the Checked page.",
  "type": "object",
  "additionalProperties": false,
  "required": ["url"],
  "properties": {
    "url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2000
    }
  }
}
