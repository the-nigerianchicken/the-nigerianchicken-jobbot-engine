{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobbot.invalid/schema/person-add.json",
  "title": "PersonAdd",
  "description": "A person the owner adds: the name the app shows for them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "[^ ]" }
  }
}
